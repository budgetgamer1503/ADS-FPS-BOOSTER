{
    "format_version": "1.8.0",
    "render_controllers": {
        "controller.render.experience_orb": {
            "geometry": "geometry.default",
            "materials": [{"*": "material.default"}],
            "textures": ["texture.default"],
            "overlay_color": {"r": "(math.sin(query.life_time*400)+1.2)*0.333", "g": "1", "b": "(math.sin(query.life_time*300+90)+1.5)*1", "a": "0.5"},
            "ignore_lighting": true,
            "uv_anim": {"offset": ["variable.u", "variable.v"], "scale": [1, 1]}
        }
    }
}